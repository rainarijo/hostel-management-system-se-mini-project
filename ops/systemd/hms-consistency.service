[Unit]
Description=HMS nightly consistency check (NFR-REL-1)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=hms
WorkingDirectory=/opt/hms
EnvironmentFile=/etc/hms/hms.env
ExecStart=/opt/hms/.venv/bin/python manage.py nightly_consistency_check
