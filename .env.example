# Copy to .env and adjust. Never commit .env (SEC-REQ-10).
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# sqlite (default, zero setup) or postgres
DB_ENGINE=sqlite
DB_NAME=hms
DB_USER=hms
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# E-mail. The console backend prints mail to the terminal; use
# django.core.mail.backends.smtp.EmailBackend with real SMTP values on a server.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=HMS <no-reply@hms.local>

# Adds a Server-Timing response header (performance tests only)
HMS_SERVER_TIMING=False
